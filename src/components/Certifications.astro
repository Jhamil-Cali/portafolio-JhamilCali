---
import { certifications } from '../data/profile';
---

<section id="certificaciones" class="section">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Formación continua</p>
      <h2 class="section-title">Certificaciones</h2>
      <p class="section-sub">
        Cursos y certificaciones en ciberseguridad, desarrollo, redes, blockchain y diseño.
      </p>
    </div>

    <div class="cert-years">
      {
        certifications.map((group, i) => (
          <details class="cert-year card reveal" open={i === 0}>
            <summary>
              <span class="year-label">
                <span class="year-dot" aria-hidden="true" />
                {group.year}
              </span>
              <span class="year-count">{group.items.length} certificaciones</span>
              <svg class="chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>

            <ul class="cert-list">
              {group.items.map((item) => (
                <li class="cert-item">
                  <div class="cert-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4Z" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                  </div>
                  <div class="cert-info">
                    <p class="cert-title">{item.title}</p>
                    <p class="cert-org">{item.org} · {item.date}</p>
                  </div>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cert-years {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .cert-year {
    padding: 0;
    overflow: hidden;
  }

  .cert-year summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.35rem 1.75rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .cert-year summary::-webkit-details-marker {
    display: none;
  }

  .year-label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--text);
  }

  .year-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--neon);
    box-shadow: var(--glow-sm);
  }

  .year-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-right: auto;
  }

  .chevron {
    color: var(--neon);
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .cert-year[open] .chevron {
    transform: rotate(180deg);
  }

  .cert-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.1rem 1.5rem;
    padding: 0.25rem 1.75rem 1.6rem;
    border-top: 1px solid var(--border);
    padding-top: 1.1rem;
  }

  .cert-item {
    display: flex;
    gap: 0.75rem;
    padding-block: 0.7rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
  }

  .cert-icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--neon);
    background: rgba(0, 229, 255, 0.05);
  }

  .cert-title {
    font-size: 0.88rem;
    color: var(--text);
    line-height: 1.4;
  }

  .cert-org {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    margin-top: 0.25rem;
  }

  @media (max-width: 760px) {
    .cert-list {
      grid-template-columns: 1fr;
    }
    .year-count {
      display: none;
    }
  }
</style>
