---
import { profile } from '../data/profile';
---

<section id="contacto" class="section contact">
  <div class="container">
    <div class="contact-card card reveal">
      <div class="contact-glow" aria-hidden="true"></div>
      <p class="eyebrow">Contacto</p>
      <h2 class="section-title">
        Construyamos algo <span class="glow-text">juntos</span>
      </h2>
      <p class="contact-text">
        ¿Tienes un proyecto de blockchain, ciberseguridad o desarrollo web en mente? Escríbeme,
        estoy siempre abierto a nuevos retos y colaboraciones.
      </p>

      <div class="contact-links">
        <a href={`mailto:${profile.email}`} class="contact-item">
          <span class="contact-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
              <path d="m3 6.5 9 6.5 9-6.5" />
            </svg>
          </span>
          <span>
            <span class="contact-label">Correo</span>
            <span class="contact-value">{profile.email}</span>
          </span>
        </a>

        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="contact-item">
          <span class="contact-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.38 7.86 10.9.57.1.78-.25.78-.55v-2.14c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.29-1.68-1.29-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.07.78 2.16v3.2c0 .3.21.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
              ></path>
            </svg>
          </span>
          <span>
            <span class="contact-label">GitHub</span>
            <span class="contact-value">{profile.githubHandle}</span>
          </span>
        </a>

        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="contact-item">
          <span class="contact-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path
                d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.25 2.37 4.25 5.44v6.3ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z"
              ></path>
            </svg>
          </span>
          <span>
            <span class="contact-label">LinkedIn</span>
            <span class="contact-value">{profile.linkedinHandle}</span>
          </span>
        </a>
      </div>

      <a href={`mailto:${profile.email}`} class="btn btn-primary contact-cta">Enviar un correo</a>
    </div>
  </div>
</section>

<style>
  .contact-card {
    position: relative;
    padding: clamp(2rem, 6vw, 3.5rem);
    overflow: hidden;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-glow {
    position: absolute;
    inset: -40% -10% auto -10%;
    height: 260px;
    background: radial-gradient(ellipse, rgba(0, 229, 255, 0.16), transparent 65%);
    pointer-events: none;
  }

  .contact-text {
    max-width: 56ch;
    margin: 1rem auto 0;
    color: var(--text-dim);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.25rem;
    width: 100%;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(0, 229, 255, 0.03);
    transition: all 0.25s ease;
    text-align: left;
  }

  .contact-item:hover {
    border-color: var(--border-strong);
    box-shadow: var(--glow-sm);
    transform: translateY(-2px);
  }

  .contact-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: rgba(0, 229, 255, 0.08);
    color: var(--neon);
    flex-shrink: 0;
  }

  .contact-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .contact-value {
    display: block;
    font-size: 0.88rem;
    color: var(--text);
    margin-top: 0.15rem;
  }

  .contact-cta {
    margin-top: 2.25rem;
  }
</style>
