---
import { education } from '../data/profile';
---

<section id="educacion" class="section">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Formación</p>
      <h2 class="section-title">Educación</h2>
    </div>

    <div class="edu-list">
      {
        education.map((edu) => (
          <div class="edu-card card reveal">
            <div class="edu-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 3 2 8l10 5 10-5-10-5Z" />
                <path d="M6 10.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5" />
              </svg>
            </div>
            <div class="edu-body">
              <div class="edu-top">
                <h3 class="edu-institution">{edu.institution}</h3>
                <span class="tag">{edu.period}</span>
              </div>
              <p class="edu-degree">{edu.degree}</p>
              <p class="edu-detail">{edu.detail}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .edu-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.75rem;
  }

  .edu-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    background: rgba(0, 229, 255, 0.06);
    color: var(--neon);
    box-shadow: var(--glow-sm);
  }

  .edu-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .edu-institution {
    font-size: 1.1rem;
  }

  .edu-degree {
    color: var(--text);
    font-size: 0.96rem;
    margin-bottom: 0.25rem;
  }

  .edu-detail {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }
</style>
